rules_version = '2';

// ============================================================================
// FantaMantra Patti — Asta Online — Regole di sicurezza Firestore
// ============================================================================
// Modello:
//  - config/public   : impostazioni lega (squadre, budget, regole rosa, timer,
//                        ordine di chiamata dei calciatori)
//  - players/{id}     : listone (un documento per calciatore)
//  - teams/{id}        : una squadra (crediti residui + rosa acquistata)
//  - state/auction    : stato live dell'asta (chi si sta chiamando, offerta
//                        corrente, timer, ultime assegnazioni)
//
// Chi può scrivere cosa:
//  - L'ADMIN (Roberto, loggato con email+password Firebase, riconosciuto dal
//    suo UID) può scrivere ovunque: carica il listone, configura le squadre,
//    avvia/ferma l'asta, chiama il prossimo giocatore, assegna il giocatore
//    alla squadra vincitrice, corregge rose/crediti a mano, esporta.
//  - I PARTECIPANTI (nessun login, solo scelta della squadra) possono SOLO
//    rilanciare: alzare currentBid/currentBidTeam/timerEndsAt sul documento
//    state/auction, e SOLO se l'asta è in corso ("bidding"), il rilancio è
//    più alto di quello attuale, e la loro squadra ha credito sufficiente.
//    Non possono mai toccare players/teams direttamente: l'assegnazione
//    finale del giocatore (che sposta crediti e aggiorna le rose) la fa
//    sempre e solo l'admin, quindi non ci sono mai due browser che scrivono
//    in conflitto sullo stesso documento squadra/giocatore.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.uid == "Hj96TYxrF2e05prGCmMdIF1lDG03";
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      // L'admin può sempre scrivere. In più, chi sta seguendo l'asta da quella
      // squadra (nessun login, solo scelta della squadra in locale) può
      // aggiornare SOLO il proprio "battito" di presenza (lastSeen e
      // activeSessions — quest'ultimo usato per la regola "una persona per
      // squadra"): non sono dati sensibili, ma la regola comunque impedisce
      // che quella stessa scrittura tocchi crediti, rosa, nome o
      // allowMultiple — quelli cambiano solo quando l'admin assegna un
      // giocatore o configura la squadra.
      allow update: if isAdmin() || isHeartbeatOnly();
    }

    function isHeartbeatOnly() {
      let incoming = request.resource.data;
      let current  = resource.data;
      return incoming.diff(current).affectedKeys().hasOnly(["lastSeen", "activeSessions"]) &&
             incoming.lastSeen is timestamp;
    }

    match /state/auction {
      allow read: if true;
      allow create: if isAdmin();

      // L'admin può sempre aggiornare lo stato (nuovo giocatore, assegnazione,
      // pausa, ecc). Un partecipante può aggiornare SOLO per rilanciare.
      allow update: if isAdmin() || isValidBid();
    }

    function isValidBid() {
      let incoming = request.resource.data;
      let current  = resource.data;
      let team = get(/databases/$(database)/documents/teams/$(incoming.currentBidTeam)).data;
      let cfg = get(/databases/$(database)/documents/config/public).data;
      let rules = cfg.rosterRules;
      let player = get(/databases/$(database)/documents/players/$(current.currentPlayerId)).data;
      let roster = team.roster;
      let totale = roster.size();
      // Nota: non possiamo contare "quanti Portiere" con una list comprehension
      // nelle security rules, quindi il limite sui portieri viene applicato
      // solo quando il calciatore in asta è proprio un portiere (per gli
      // altri ruoli conta solo il tetto sul totale rosa).
      let portieriRoster = roster.filter(p => p.ruolo == "Portiere");

      return
        // si può rilanciare solo mentre l'asta è aperta sul giocatore corrente
        current.status == "bidding" &&
        incoming.status == "bidding" &&
        incoming.currentPlayerId == current.currentPlayerId &&

        // il nuovo rilancio deve essere un numero più alto di quello attuale
        incoming.currentBid is number &&
        incoming.currentBid > current.currentBid &&

        // deve dichiarare una squadra valida tra quelle configurate
        incoming.currentBidTeam is string &&

        // la squadra che rilancia deve avere credito sufficiente
        team.credits >= incoming.currentBid &&

        // la rosa della squadra non deve essere già al completo per questo
        // ruolo/totale: altrimenti non può proprio rilanciare su quel
        // calciatore (lato client i pulsanti sono già disabilitati, questa è
        // la stessa regola applicata anche lato server).
        totale < rules.totaleMax &&
        (player.ruolo != "Portiere" || portieriRoster.size() < rules.portiereMax) &&

        // il timer deve essere spostato in avanti (si sta resettando il countdown)
        incoming.timerEndsAt is timestamp &&

        // tutti gli altri campi restano invariati: un rilancio non può
        // toccare lo storico vendite o altro
        incoming.lastSoldPlayerId == current.lastSoldPlayerId &&
        incoming.lastSoldTeam == current.lastSoldTeam &&
        incoming.lastSoldPrice == current.lastSoldPrice;
    }
  }
}
